# Copy to .env.bridge (gitignored) and fill in. Names and placeholders only.
#   cp .env.bridge.example .env.bridge && chmod 600 .env.bridge

# Required: admin UI key, at least 16 characters, e.g. `openssl rand -hex 24`.
SEP2_ADMIN_UI_KEY=

# Optional: empty or unset means the compose default (or the bridge's own for
# the feeder and simulation id). Comments go on their own lines, never after a value.
SEP2_FEEDER_MRID=
SEP2_SIMULATION_ID=
SEP2_STOMP_USER=system
SEP2_STOMP_PASSWORD=manager
SEP2_STOMP_ALLOW_PLAINTEXT=true

# Optional launcher settings (defaults shown).
# BRIDGE_SEP2_PORT=18443
# BRIDGE_ADMIN_PORT=18444
# BRIDGE_USER=1000:1000
# BRIDGE_CERT_DIR=/absolute/path/to/sep2-certs   (default: ~/.config/gridappsd/2030.5server/sep2-certs)
# BRIDGE_CERT_MODE=rw
# BRIDGE_ADMIN_SUBNET=10.213.168.0/24
# BRIDGE_ADMIN_IP=10.213.168.2
