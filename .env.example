# Copy to .env (gitignored) and fill in the two bridge secrets. Compose reads
# .env on its own, and `make docker-up` passes it explicitly.
#   cp .env.example .env && chmod 600 .env
# Two stacks read this file: the bridge (docker-compose.bridge.yml, the first
# section, every setting it reads) and the dev ActiveMQ broker (docker-compose.yml,
# the last section). Their variable names do not overlap. Each value is what the
# compose file uses when it is unset; docs/CONFIGURATION.md describes each bridge
# setting. Comments go on their own lines, never after a value.
# Within the bridge section, settings run from the ones users change most often
# to the tuning knobs, in the numbered groups below.

# === Bridge (docker-compose.bridge.yml) ===

# --- 1. Host ports and network ---
# Launcher settings read by scripts/docker-bridge.sh (defaults shown). Leave them
# commented to take the default.
# BRIDGE_SEP2_PORT=18443
# BRIDGE_ADMIN_PORT=18444
# Host address each port is published on (IPv4). The 2030.5 port defaults to
# 0.0.0.0 (every address, mTLS required); Docker-published ports bypass host
# firewall INPUT rules, so set 127.0.0.1 or a LAN address to restrict it. The
# admin UI is plain HTTP behind one key, so leave BRIDGE_ADMIN_BIND_IP on its
# 127.0.0.1 default. docs/DOCKER.md says what else changes.
# BRIDGE_SEP2_BIND_IP=0.0.0.0
# BRIDGE_ADMIN_BIND_IP=127.0.0.1
# BRIDGE_ADMIN_SUBNET=10.213.168.0/24
# BRIDGE_ADMIN_IP=10.213.168.2
# Broker host:port; the platform container name on the platform network.
SEP2_STOMP_ADDR=gridappsd:61613
# GRIDAPPSD_ADDRESS is not passed to the container: SEP2_STOMP_ADDR above always has a value and wins.
# GRIDAPPSD_PORT is not passed to the container: SEP2_STOMP_ADDR above always has a value and wins.
# Plaintext STOMP; the platform broker needs it.
SEP2_STOMP_ALLOW_PLAINTEXT=true

# --- 2. Required credentials ---
# Admin key, at least 16 characters, e.g. `openssl rand -hex 24`. Secret, no default.
SEP2_ADMIN_UI_KEY=
# Broker login, in the names other GridAPPS-D apps read. Empty user means system.
GRIDAPPSD_USER=
# Broker password. Secret: set it here (the platform ships a documented dev default); make docker-up refuses to start without it.
GRIDAPPSD_PASSWORD=
# Overrides for the pair above; precedence is SEP2_ name, then GRIDAPPSD_ name, then default. Leave empty to use the pair.
SEP2_STOMP_USER=
SEP2_STOMP_PASSWORD=
# Fleet-wide registration PIN, 0-999999 with a valid check digit. Secret; empty means none.
SEP2_REGISTRATION_PIN=
# Container path to a JSON file of device LFDI to PIN; must be inside a mount, such as /etc/sep2/certs. Empty means none.
SEP2_REGISTRATION_PIN_FILE=

# --- 3. Grid and simulation ---
# GridAPPS-D simulation_id to subscribe to; empty subscribes to none.
SEP2_SIMULATION_ID=
# GridAPPS-D application id used in the output and input topics.
SEP2_APPLICATION_ID=IEEE_2030_5
# CIM feeder mRID to enumerate DERs from (the IEEE 123-bus feeder).
SEP2_FEEDER_MRID=_C1C3E687-6FFD-C753-582B-632A27E28507
# Path inside the container to a file of battery leg mRIDs; empty registers none.
SEP2_BATTERY_LEG_LIST_FILE=

# --- 4. Image and run mode ---
# Published image version for compose run by hand (default: latest). make docker-up
# pulls this version. BRIDGE_USE_PUBLISHED=0 makes make docker-up build locally instead.
# docs/DOCKER.md describes both paths.
# BRIDGE_IMAGE_TAG=latest
# BRIDGE_USE_PUBLISHED=1
# BRIDGE_USER=1000:1000
# BRIDGE_CERT_DIR=/absolute/path/to/sep2-certs   (default: ~/.config/gridappsd/2030.5server/sep2-certs)
# BRIDGE_CERT_MODE=rw
# Host path to a PEM bundle the local image build trusts for its Go downloads (TLS-inspecting proxy); never stored in the image.
# BRIDGE_EXTRA_CA_FILE=

# --- 5. Certificates and devices ---
# dev-mint or preprovisioned.
SEP2_DEVICE_CERT_MODE=dev-mint
# Comma-separated extra names or IPs for the server certificate dev-mint creates,
# beside localhost and 127.0.0.1. Applies only when the cert dir is empty; an
# existing server certificate is not re-minted (docs/DOCKER.md).
SEP2_SERVER_CERT_HOSTS=
# Fleet-wide Registration poll rate in seconds; empty advertises none.
SEP2_POLL_RATE=
# Fleet-wide MirrorUsagePoint post rate in seconds; empty advertises none.
SEP2_POST_RATE=
# IEEE 2030.5 edition; only 2018 is supported.
SEP2_EDITION=2018
# IANA Private Enterprise Number for minted mRIDs; empty leaves them random.
SEP2_PEN=

# --- 6. Publishing, access and protocol behaviour ---
# Accepted but does nothing yet.
SEP2_PUBLISH_ON_START=false
# Publish every device each tick, not only the ones that changed.
SEP2_TELEMETRY_PUBLISH_UNCHANGED=false
# Allow loopback notificationURI targets. Test harnesses only, never production.
SEP2_NOTIFICATION_ALLOW_LOOPBACK=false
# Pending removal; needs SEP2_CCM_ALLOW_NO_OBSERVER too.
SEP2_ENABLE_CCM=false
# Accept losing the connection observer; pending removal.
SEP2_CCM_ALLOW_NO_OBSERVER=false
# Comma-separated extra accepted Host header values; needed to open the admin UI by any name or address other than localhost, 127.0.0.1 and ::1.
SEP2_ADMIN_UI_ALLOWED_HOSTS=
# Optional server-of-record dashboard URL shown by /api/health.
SEP2_ADMIN_UI_SOR_LINK=
# Start with the admin UI sender's publish switch on; false means off after every start.
SEP2_ADMIN_UI_BUS_PUBLISH_AT_START=false

# --- 7. Timing and tuning knobs ---
# Broker dial plus token bootstrap budget, 1s-5m.
SEP2_STOMP_CONNECT_TIMEOUT=15s
# STOMP heartbeat interval offered to the broker, 1s-5m.
SEP2_STOMP_HEARTBEAT=10s
# Gap between broker liveness probes, 1s-1h.
SEP2_STOMP_PROBE_INTERVAL=5s
# Time one liveness probe may take, 1s-5m.
SEP2_STOMP_PROBE_TIMEOUT=10s
# First delay between reconnect attempts, 100ms-1m.
SEP2_STOMP_RECONNECT_BACKOFF_BASE=500ms
# Longest reconnect delay, 1s-10m, not below the base.
SEP2_STOMP_RECONNECT_BACKOFF_MAX=10s
# Wait for the broker to acknowledge an unsubscribe at shutdown, 1s-5m.
SEP2_STOMP_UNSUBSCRIBE_TIMEOUT=5s
# Budget for the start-up CIM feeder queries, 1s-10m.
SEP2_CIM_QUERY_TIMEOUT=30s
# Minimum gap between history log lines of one kind, 1s-1h.
SEP2_HISTORY_LOG_INTERVAL=30s
# Protocol listener request header read, 1s-1h.
SEP2_SERVER_READ_HEADER_TIMEOUT=10s
# Protocol listener full request read, 1s-1h.
SEP2_SERVER_READ_TIMEOUT=30s
# Protocol listener response write, 1s-1h.
SEP2_SERVER_WRITE_TIMEOUT=30s
# Protocol listener keep-alive idle time, 1s-1h.
SEP2_SERVER_IDLE_TIMEOUT=120s
# Protocol listener graceful drain at shutdown, 1s-5m.
SEP2_SERVER_SHUTDOWN_TIMEOUT=5s
# How often ended DERControls are expired, 1s-1h.
SEP2_CONTROL_SWEEP_INTERVAL=10s
# Time one subscription notification POST may take, 1s-5m.
SEP2_NOTIFY_POST_TIMEOUT=30s
# Connect budget for one notification POST, 1s-5m.
SEP2_NOTIFY_DIAL_TIMEOUT=30s
# DNS check on a notificationURI at creation, 1s-5m.
SEP2_NOTIFY_RESOLVE_TIMEOUT=5s
# Inbound TLS handshake budget on the protocol listener, 1s-5m.
SEP2_CCM_HANDSHAKE_TIMEOUT=10s
# Notification worker count, 1-1024.
SEP2_NOTIFY_WORKERS=4
# Notification queue length, 1-100000.
SEP2_NOTIFY_QUEUE_SIZE=100
# Admin UI request header read, 1s-1h.
SEP2_ADMIN_UI_READ_HEADER_TIMEOUT=5s
# Admin UI full request read, 1s-1h.
SEP2_ADMIN_UI_READ_TIMEOUT=10s
# Admin UI response write, 1s-1h.
SEP2_ADMIN_UI_WRITE_TIMEOUT=10s
# Admin UI keep-alive idle time, 1s-1h.
SEP2_ADMIN_UI_IDLE_TIMEOUT=60s
# Admin UI graceful drain at shutdown, 1s-5m.
SEP2_ADMIN_UI_SHUTDOWN_TIMEOUT=5s
# Age past which an unseen client shows as idle in the admin UI, 30s-24h.
SEP2_ADMIN_UI_CLIENT_IDLE_AFTER=5m
# Whole seconds, 1-3600.
SEP2_FLOW_RESERVATION_DEADLINE_SECONDS=300
# Whole seconds, 900-604800; no effect in the bridge today.
SEP2_FLOW_RESERVATION_RETENTION_GRACE_SECONDS=1800
# DERStatus publish period as a Go duration, above zero.
SEP2_TELEMETRY_INTERVAL=15s

# --- Advanced: fixed in docker-compose.bridge.yml, not settings ---
# SEP2_SERVER_ADDR is fixed in docker-compose.bridge.yml (0.0.0.0:18443); not a setting.
# SEP2_SERVER_CERT_DIR is fixed in docker-compose.bridge.yml (/etc/sep2/certs); not a setting.
# SEP2_ADMIN_UI_ADDR is fixed in docker-compose.bridge.yml (BRIDGE_ADMIN_IP:18444); not a setting.
# SEP2_ADMIN_UI_ALLOW_NON_LOOPBACK is fixed in docker-compose.bridge.yml (true); not a setting.

# === Dev ActiveMQ broker (docker-compose.yml), DEV ONLY ===
# Not for production: the credentials are the public upstream defaults; the
# bind address is fixed at 127.0.0.1 in docker-compose.yml.

# STOMP listener port on the host. ActiveMQ inside the container
# always listens on 61613.
#
# The bind address is fixed at 127.0.0.1 in docker-compose.yml so the
# dev broker is not exposed on the LAN with the default system/manager
# credentials (Leon M3). A developer needing cross-machine access for
# multi-host testing should edit docker-compose.yml directly with
# awareness of the exposure; STOMP_PORT alone does not change the
# bind address.
STOMP_PORT=61613

# Web console port on the host. ActiveMQ inside the container always
# listens on 8161. Do not expose this port outside the dev box. Like
# STOMP_PORT, the bind address is fixed at 127.0.0.1 in
# docker-compose.yml.
CONSOLE_PORT=8161

# ActiveMQ broker credentials. The cimstomp.Client and Publisher use
# these via STOMPConfig.User / STOMPConfig.Password. Override these
# in your .env (and rotate them) for any deployment beyond a dev
# laptop.
ACTIVEMQ_CONNECTION_USER=system
ACTIVEMQ_CONNECTION_PASSWORD=manager
